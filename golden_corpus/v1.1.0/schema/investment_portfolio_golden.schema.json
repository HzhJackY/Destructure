{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investment_portfolio_golden.schema.json",
  "title": "Investment portfolio Golden anchor and disclosed-total contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "golden_id",
    "family",
    "company_id",
    "legal_entity_name",
    "report_year",
    "source",
    "source_scope",
    "disclosure_topology",
    "reported_portfolio_total",
    "physical_assets",
    "coverage",
    "annotation_status",
    "reviewer",
    "review_date"
  ],
  "properties": {
    "schema_version": {"const": "investment_portfolio_golden_v2"},
    "golden_id": {"type": "string", "minLength": 1},
    "family": {"const": "investment_portfolio"},
    "company_id": {"type": "string", "minLength": 1},
    "legal_entity_name": {"type": "string", "minLength": 1},
    "report_year": {"type": "integer", "minimum": 2000},
    "source_scope": {"const": "LISTED_PARENT_CONSOLIDATED"},
    "disclosure_topology": {
      "enum": [
        "DIRECT_SEPARATE_TABLES_SAME_PAGE",
        "DIRECT_COMPOUND_TABLE",
        "DIRECT_SINGLE_AXIS_TABLE"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_pdf_filename", "pdf_sha256", "page_count", "source_type"],
      "properties": {
        "canonical_pdf_filename": {"type": "string", "minLength": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "source_type": {"const": "ANNUAL_REPORT"},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "reported_portfolio_total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "derivation_allowed"],
      "properties": {
        "status": {"const": "DISCLOSED"},
        "derivation_allowed": {"const": false}
      }
    },
    "physical_assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/physicalAsset"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_identity", "total_values", "row_values"],
      "properties": {
        "asset_identity": {"const": "FULL"},
        "total_values": {"const": "FULL"},
        "row_values": {"const": "FULL"}
      }
    },
    "annotation_status": {"const": "CERTIFIED_GOLDEN_ROW_VALUES"},
    "reviewer": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "format": "date"},
    "audit_note": {"type": "string"}
  },
  "$defs": {
    "periodValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "amount", "ratio_percent"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "amount": {"type": "integer"},
        "ratio_percent": {"type": ["number", "null"]}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "classification_axis", "logical_title", "current_period", "comparative_period", "rows"],
      "properties": {
        "member_id": {"enum": ["portfolio_by_category", "portfolio_by_measurement"]},
        "classification_axis": {"enum": ["BY_INVESTMENT_OBJECT", "BY_ACCOUNTING_MEASUREMENT"]},
        "logical_title": {"type": "string", "minLength": 1},
        "current_period": {"$ref": "#/$defs/periodValue"},
        "comparative_period": {"$ref": "#/$defs/periodValue"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/portfolioRow"}
        }
      }
    },
    "portfolioRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_order",
        "raw_label",
        "normalized_label",
        "row_kind",
        "current_amount",
        "current_ratio_percent",
        "comparative_amount",
        "comparative_ratio_percent"
      ],
      "properties": {
        "row_order": {"type": "integer", "minimum": 1},
        "raw_label": {"type": "string", "minLength": 1},
        "normalized_label": {"type": "string", "minLength": 1},
        "row_kind": {"enum": ["GROUP", "DATA", "TOTAL"]},
        "parent_row_order": {"type": ["integer", "null"], "minimum": 1},
        "current_amount": {"type": ["integer", "null"]},
        "current_ratio_percent": {"type": ["number", "null"]},
        "comparative_amount": {"type": ["integer", "null"]},
        "comparative_ratio_percent": {"type": ["number", "null"]},
        "change_percent": {"type": ["number", "null"]}
      }
    },
    "physicalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "physical_page_number",
        "printed_page_number",
        "title",
        "unit",
        "native_text_verified",
        "ocr_used",
        "blocks"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "physical_page_number": {"type": "integer", "minimum": 1},
        "printed_page_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "unit": {"enum": ["RMB_MILLION", "RMB_THOUSAND", "USD_MILLION", "RMB_YUAN"]},
        "native_text_verified": {"const": true},
        "ocr_used": {"const": false},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}
      }
    }
  }
}
