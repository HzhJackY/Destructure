{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldenCoverageRegistryRow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filing_id": {"type": "string", "pattern": "^[A-Z_]+_[0-9]{4}$"},
    "company_id": {"type": "string"},
    "company_name": {"type": "string"},
    "report_year": {"type": "string", "pattern": "^[0-9]{4}$"},
    "page_anchor_status": {"enum": ["CERTIFIED_GOLDEN", "MISSING"]},
    "disclosure_pattern_status": {"enum": ["CERTIFIED_GOLDEN", "MISSING"]},
    "main_statement_value_golden_status": {"enum": ["CERTIFIED_GOLDEN", "MISSING"]},
    "main_statement_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "primary_child_table_golden_status": {"enum": ["CERTIFIED_GOLDEN", "MISSING"]},
    "primary_child_table_count": {"type": "string", "pattern": "^[0-9]+$"},
    "primary_child_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "supplementary_child_table_golden_status": {"enum": ["CERTIFIED_GOLDEN", "NOT_AUDITED"]},
    "supplementary_child_table_count": {"type": "string", "pattern": "^[0-9]+$"},
    "supplementary_child_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "continuation_segment_golden_status": {"enum": ["CERTIFIED_GOLDEN", "NOT_AUDITED"]},
    "continuation_segment_count": {"type": "string", "pattern": "^[0-9]+$"},
    "continuation_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "current_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "comparative_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "restated_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "schema_validation_status": {"enum": ["VALID"]},
    "evidence_crops_status": {"enum": ["AVAILABLE", "MISSING"]},
    "last_adjudicated_by": {"type": "string"},
    "last_adjudicated_date": {"type": "string", "format": "date"},
    "annotation_change_log_id": {"type": "string"},
    "primary_only_release_status": {"type": "string"},
    "all_note_tables_release_status": {"type": "string"},
    "audit_note": {"type": "string"}
  },
  "required": [
    "filing_id", "company_id", "company_name", "report_year",
    "page_anchor_status", "disclosure_pattern_status",
    "main_statement_value_golden_status", "main_statement_value_assertion_count",
    "primary_child_table_golden_status", "primary_child_table_count",
    "primary_child_value_assertion_count", "supplementary_child_table_golden_status",
    "supplementary_child_table_count", "supplementary_child_value_assertion_count",
    "continuation_segment_golden_status", "continuation_segment_count",
    "continuation_value_assertion_count", "current_period_value_assertion_count",
    "comparative_period_value_assertion_count", "restated_period_value_assertion_count",
    "schema_validation_status", "evidence_crops_status", "last_adjudicated_by",
    "last_adjudicated_date", "annotation_change_log_id", "primary_only_release_status",
    "all_note_tables_release_status", "audit_note"
  ]
}
