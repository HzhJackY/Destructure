{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldenTableSegmentRegistryRow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logical_table_id": {"type": "string", "minLength": 1},
    "physical_segment_id": {"type": "string", "minLength": 1},
    "filing_id": {"type": "string", "pattern": "^[A-Z_]+_[0-9]{4}$"},
    "member_id": {"type": "string", "minLength": 1},
    "table_classification": {"enum": ["PRIMARY_TABLE", "SUPPLEMENTARY_TABLE", "CONTINUATION_SEGMENT"]},
    "segment_role": {"enum": ["LOGICAL_ROOT", "INDEPENDENT_LOGICAL_TABLE", "PHYSICAL_CONTINUATION"]},
    "associated_primary_logical_table_id": {"type": "string"},
    "continuation_of_physical_segment_id": {"type": "string"},
    "note_reference": {"type": "string", "minLength": 1},
    "raw_table_title": {"type": "string", "minLength": 1},
    "pdf_page_start": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "pdf_page_end": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "golden_asset_path": {"type": "string", "pattern": "^companies/.+\\.yaml$"},
    "table_identity_assertion_status": {"enum": ["CERTIFIED_GOLDEN"]},
    "structure_assertion_status": {"enum": ["CERTIFIED_GOLDEN"]},
    "value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "current_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "comparative_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "restated_period_value_assertion_count": {"type": "string", "pattern": "^[0-9]+$"},
    "continuation_relation_status": {"enum": ["NOT_APPLICABLE", "CERTIFIED_GOLDEN"]},
    "continuation_evidence_ref": {"type": "string"},
    "annotation_status": {"enum": ["CERTIFIED_GOLDEN"]},
    "reviewer": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "format": "date"},
    "annotation_change_log_id": {"type": "string", "minLength": 1},
    "release_blocking_status": {"type": "string", "minLength": 1}
  },
  "required": [
    "logical_table_id", "physical_segment_id", "filing_id", "member_id",
    "table_classification", "segment_role", "associated_primary_logical_table_id",
    "continuation_of_physical_segment_id", "note_reference", "raw_table_title",
    "pdf_page_start", "pdf_page_end", "golden_asset_path",
    "table_identity_assertion_status", "structure_assertion_status",
    "value_assertion_count", "current_period_value_assertion_count",
    "comparative_period_value_assertion_count", "restated_period_value_assertion_count",
    "continuation_relation_status", "continuation_evidence_ref", "annotation_status",
    "reviewer", "review_date", "annotation_change_log_id", "release_blocking_status"
  ]
}
