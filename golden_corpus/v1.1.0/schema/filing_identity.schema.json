{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FilingIdentitySchema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "filing_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_legal_name": {
      "type": "string"
    },
    "report_year": {
      "type": "integer"
    },
    "report_type": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "canonical_pdf_filename": {
      "type": "string"
    },
    "pdf_sha256": {
      "type": "string"
    },
    "page_count": {
      "type": "integer"
    },
    "file_size_bytes": {
      "type": "integer"
    },
    "document_modality": {
      "type": "string"
    },
    "canonical_for_testing": {
      "type": "boolean"
    },
    "annotation_status": {
      "type": "string"
    },
    "source_directory": {
      "type": "string"
    }
  },
  "required": [
    "filing_id",
    "company_id",
    "report_year",
    "canonical_pdf_filename",
    "pdf_sha256",
    "page_count",
    "document_modality",
    "annotation_status"
  ]
}